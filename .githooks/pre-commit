#!/usr/bin/env bash
# Pre-commit: the fast checks on what's staged — formatting, clippy, and the
# suppression/debug greps. Tests run at pre-push, scoped to what the push touches.
unset $(git rev-parse --local-env-vars)
set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if ! grep -qE '\.(rs|toml)$' <<<"$STAGED"; then
    exit 0
fi

failed=()

if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo -e "${RED}✗ fmt${NC}: run 'cargo fmt --all', re-stage, and commit again"
    failed+=(fmt)
fi

if ! OUTPUT=$(cargo clippy --all-targets --all-features -- -D warnings 2>&1); then
    echo "$OUTPUT"
    echo -e "${RED}✗ clippy${NC}"
    failed+=(clippy)
fi

ADDED_RS=$(git diff --cached --diff-filter=ACM -- '*.rs' | grep -E '^\+' || true)
if grep -qE '\bdbg!\(' <<<"$ADDED_RS"; then
    echo -e "${RED}✗ dbg!()${NC} in staged changes; remove it"
    failed+=(dbg)
fi
if grep -qE '#\[allow\(' <<<"$ADDED_RS"; then
    echo -e "${RED}✗ #[allow(...)]${NC} in staged changes; use #[expect(lint, reason = \"...\")]"
    failed+=(allow)
fi

if [ ${#failed[@]} -gt 0 ]; then
    echo -e "${RED}pre-commit failed: ${failed[*]}${NC}"
    exit 1
fi
echo -e "${GREEN}pre-commit ok${NC} ${YELLOW}(tests run at pre-push)${NC}"
