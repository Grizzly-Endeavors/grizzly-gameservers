# Live mode only. Replay mode needs none of this.
# Base URL of Gary's operator harness (e.g. a port-forward to the bot's agent port).
GARY_OPERATOR_URL=http://localhost:9360
# The operator bearer token. Stays server-side in the Vite proxy.
GARY_OPERATOR_TOKEN=
# Discord channel the harness acts in (required by POST /operator/gary).
VITE_GARY_CHANNEL=
