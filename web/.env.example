# Live mode only. Replay mode needs none of this.
# Anything left blank falls back to the repo-root .env that scripts/operator.sh reads
# (GAMESERVERS_OPERATOR_TOKEN, GAMESERVERS_OPERATOR_CHANNEL).

# Gary's operator harness. Default: the port-forward below, on localhost:19360.
GARY_OPERATOR_URL=
# The operator bearer token. Used by the dev-server proxy only; never sent to the browser.
GARY_OPERATOR_TOKEN=
# Discord channel id Gary acts in (replies and confirmation cards land there).
VITE_GARY_CHANNEL=
