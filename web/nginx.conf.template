# Rendered at container start by the nginx image's envsubst step (only the
# variables set in the pod's env are substituted, so nginx's own $vars pass
# through). GARY_OPERATOR_TOKEN and GARY_CHANNEL come from the
# gary-web-live Secret; see web/deploy/deployment.yaml.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Live mode: Gary's operator harness, with the bearer token added here so
    # it never reaches the browser. This replaces the visitor's basic-auth
    # Authorization header, which the Ingress has already checked.
    location /operator/ {
        proxy_pass http://grizzly-gameservers-agent.game-servers.svc.cluster.local:9360;
        proxy_set_header Authorization "Bearer ${GARY_OPERATOR_TOKEN}";
        proxy_set_header Cookie "";
        # A Gary turn can run for minutes; the UI waits up to 15.
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location = /runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.__GARY__ = { channel: "${GARY_CHANNEL}" };\n';
    }

    # Hashed build assets never change under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
